{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ahmdow80",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "e093220c-2754-42eb-b5ff-5411515c66d7","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "65a4896c939043f29f00d2126bb628ed" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
